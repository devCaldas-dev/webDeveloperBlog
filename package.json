{
  "name": "web-developer-blog",
  "version": "3.1.2",
  "webDeveloper": "Armando Toro Cárdenas",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start": "cross-env NODE_ENV=development node scripts/generate-content.mjs && next dev --webpack",
    "dev": "cross-env NODE_ENV=development node scripts/generate-content.mjs && cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env NODE_ENV=production node scripts/generate-content.mjs && cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "analyze": "cross-env NODE_ENV=production node scripts/generate-content.mjs && cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.4.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "^0.5.4",
    "autoprefixer": "10.6.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "next": "16.4.3",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.2",
    "rehype-katex": "7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
