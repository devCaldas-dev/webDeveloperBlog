{
  "name": "web-developer-blog",
  "version": "3.1.1",
  "webDeveloper": "Armando Toro Cárdenas",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "start": "next dev --webpack",
    "dev": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@headlessui/react": "2.2.9",
    "@next/bundle-analyzer": "16.0.6",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.19",
    "autoprefixer": "10.4.22",
    "contentlayer2": "0.5.8",
    "date-fns": "4.1.0",
    "esbuild": "0.27.0",
    "formidable": "3.5.4",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-from-html-isomorphic": "2.0.0",
    "image-size": "2.0.2",
    "next": "16.0.7",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "pliny": "0.4.1",
    "postcss": "8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-citation": "2.3.1",
    "rehype-katex": "7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "2.0.1",
    "rehype-slug": "6.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "superagent": "10.2.3",
    "unist-util-visit": "5.0.0",
    "vercel": "48.12.0"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/mdx": "2.0.13",
    "@types/react": "19.2.7",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.7.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
